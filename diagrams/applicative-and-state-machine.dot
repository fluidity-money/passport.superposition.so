digraph {
  rankdir=TD
  subgraph cluster_Applicative { label="Applicative model"; style=dotted
    Balance -> Withdraw [label="Withdraws"]
    Balance -> Order [label="Create order"]
    Order -> Cancel -> Balance [label="Cancel order"]
    Order -> Commit -> {
      {
        CommitToBalanceLeft
        CommitToBalanceRight
        ExcessToBalanceLeft
        ExcessToBalanceRight
      } -> Balance [label="Results to Balance"]
    }
  }
  subgraph cluster_StateMachine { label="State machine"; style=dotted
    "StateMachine.commit" [label="Commit"]
    "StateMachine.commit" -> "CreateBalanceOrigin.commit"
    CreateBalance -> {
      "CreateBalanceOrigin.Single"
      "CreateBalanceOrigin.Commit"
    } -> CreateBalanceOrigin -> "SplitBalance.input" -> SplitBalance
    CreateBalance -> {
      "SplitBalance.spendable"
      "SplitBalance.excess"
    }
    {
      "SplitBalance.spendable"
      "SplitBalance.excess"
    } -> SplitBalance -> "StateBalance.Split" -> StateBalance
    CreateBalanceOrigin -> Withdrawal
    CreateBalance -> "StateBalance.Single" -> StateBalance -> "OrderCreated.from" -> OrderCreated -> {
      "Commit.left"
      "Commit.right"
      "Commit.left_fulfilled"
      "Commit.right_fulfilled"
    }
    CreateBalance -> {
      "Commit.excess_left"
      "Commit.excess_right"
    } [style=dotted]
    {
      "Commit.left"
      "Commit.right"
      "Commit.left_fulfilled"
      "Commit.right_fulfilled"
      "Commit.excess_left"
      "Commit.excess_right"
    } -> "StateMachine.commit"
    "StateMachine.commit" -> "CreateBalanceOrigin.Commit"
  }
}
