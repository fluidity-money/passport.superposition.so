digraph {
  rankdir=TD
  subgraph cluster_Applicative { label="Applicative model"; style=dotted
    Balance -> Withdraw [label="Withdraws"]
    Balance -> Order [label="Create order"]
    Balance -> Join -> Balance [label="Join balances together"]
    Order -> Cancel -> Balance [label="Cancel order"]
    Order -> Commit -> {
      {
        CommitLeftFilledToBalance
        CommitRightFilledToBalance
        CommitLeftExcessToBalance
        CommitRightExcessToBalance
      } -> Balance [label="Results to Balance"]
    }
  }
  subgraph cluster_StateMachine { label="State machine"; style=dotted
    "StateMachine.commit" [label="Commit"]
    CreateBalance -> "CreateBalanceOrigin.Single" -> CreateBalanceOrigin -> SplitBalance -> {
      SplitBalanceSpendable
      SplitBalanceSpendExcess
    } -> StateBalance
    CreateBalance -> StateBalance -> OrderCreated -> "StateMachine.commit" -> {
      "CreateBalanceOrigin.CommitSpendableLeft"
      "CreateBalanceOrigin.CommitSpendableRight"
      "CreateBalanceOrigin.CommitExcessLeft"
      "CreateBalanceOrigin.CommitExcessRight"
    } -> CreateBalanceOrigin -> "CreateBalanceOrigin.Join" -> CreateBalanceOrigin -> Withdrawal
  }
}
