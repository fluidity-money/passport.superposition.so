#!/usr/bin/env -S ocaml -w +A -w -4-42

#use "topfind"

#require "ounit2"

module Applicative = struct
  type bal
  type commit
  type order
  type withdrawn

  type bal_args = {
    bal_ms_ts : int;
    bal_owner : string;
    bal_asset : string;
    bal_amt : int;
  }

  and order_args = {
    ord_desired_asset : string;
    ord_desired_amt : int;
    ord_from : bal t;
  }

  and _ t =
    | Balance : bal_args -> bal t
    | Order : order_args -> order t
    | Commit : (int * order t * order t) -> commit t
    | Withdraw : bal t -> withdrawn t
    | Commit_left_filled_to_balance : commit t -> bal t

  let rec pp_bal fmt x =
    match x with
    | Balance { bal_ms_ts; bal_owner; bal_asset; bal_amt } ->
        Format.fprintf fmt
          "Balance { bal_ms_ts = %d;  bal_owner = %s; bal_asset = %s ; bal_amt \
           = %d }"
          bal_ms_ts bal_owner bal_asset bal_amt
    | Commit_left_filled_to_balance c ->
        Format.fprintf fmt "Commit_left_filled_to_balance { commit = %a }"
          pp_commit c

  and pp_order fmt (Order { ord_desired_asset; ord_desired_amt; ord_from }) =
    Format.fprintf fmt
      "Order { ord_desired_asset = %s ; ord_desired_amt = %d ; ord_from = %a"
      ord_desired_asset ord_desired_amt pp_bal ord_from

  and pp_commit fmt (Commit (ts, l, r)) =
    Format.fprintf fmt "Commit (%d, %a, %a)" ts pp_order l pp_order r

  and pp_withdrawn fmt (Withdraw b) =
    Format.fprintf fmt "Withdraw (%a)" pp_bal b
end

module Bucket = struct
  type t = {
    colour : [ `Ephereal | `Order ];
    from : t option;
    owner : string;
    spent : int;
    returned : int;
    asset : string;
    ts : int;
  }

  let rec pp fmt { colour; from; owner; spent; returned; asset; ts } =
    Format.fprintf fmt
      "Bucket { colour = %a; from = %a; owner = %s; spent = %d; returned = %d \
       ; asset = %s; ts = %d }"
      pp_colour colour pp_maybe from owner spent returned asset ts

  and pp_maybe fmt = function
    | Some v -> Format.fprintf fmt "Some %a" pp v
    | None -> Format.fprintf fmt "None"

  and pp_colour fmt x =
    Format.fprintf fmt "%s"
      (match x with `Ephereal -> "Ephereal" | `Order -> "Order")
end

module Convert = struct
  (* We can afford to ignore warnings here since the type isn't allowing
   * situations where this unpacking happens, unless we add extra types. *)
  [@@@warning "-8"]

  let rec bal_to_bucket = function
    | Applicative.(Balance { bal_ms_ts; bal_asset; bal_owner; bal_amt }) ->
        Bucket.
          {
            colour = `Ephereal;
            from = None;
            spent = bal_amt;
            returned = 0;
            owner = bal_owner;
            asset = bal_asset;
            ts = bal_ms_ts;
          }
    | Applicative.(Commit_left_filled_to_balance c) ->
        let b = commit_left_filled_to_bucket c in
        let Bucket.{ spent; owner; asset; ts; _ } = b in
        Bucket.
          {
            colour = `Ephereal;
            from =
              Some
                {
                  colour = `Order;
                  from = Some b;
                  spent = 0;
                  returned = 0;
                  owner;
                  asset;
                  ts;
                };
            spent;
            returned = 0;
            owner;
            asset;
            ts;
          }

  and order_to_bucket
      Applicative.(
        Order
          {
            ord_from =
              Balance { bal_ms_ts; bal_asset; bal_amt; bal_owner } as from;
            _;
          }) =
    Bucket.
      {
        colour = `Order;
        from = Some (bal_to_bucket from);
        spent = bal_amt;
        returned = 0;
        owner = bal_owner;
        asset = bal_asset;
        ts = bal_ms_ts;
      }

  and order_amt Applicative.(Order { ord_from = Balance { bal_amt; _ }; _ }) =
    bal_amt

  and order_asset Applicative.(Order { ord_from = Balance { bal_asset; _ }; _ })
      =
    bal_asset

  and order_desired_amt Applicative.(Order { ord_desired_amt; _ }) =
    ord_desired_amt

  and order_desired_asset Applicative.(Order { ord_desired_asset; _ }) =
    ord_desired_asset

  and order_owner Applicative.(Order { ord_from = Balance { bal_owner; _ }; _ })
      =
    bal_owner

  (** chain_buckets by appending the left side to the right side. *)
  and chain_buckets x = function
    | Bucket.{ from = Some from; _ } -> chain_buckets x from
    | Bucket.{ from = None; _ } as b -> Bucket.{ b with from = Some x }

  and commit_left_filled_to_bucket (Applicative.Commit (ts, l, r)) =
    let l_buck = order_to_bucket l in
    let r_buck = order_to_bucket r in
    let l_avail = order_amt l in
    let r_avail = order_amt r in
    let l_desired_amt = order_desired_amt l in
    let r_desired_amt = order_desired_amt r in
    let l_desired_asset = order_desired_asset l in
    let r_desired_asset = order_desired_asset r in
    if not (l_desired_asset = order_asset r) then invalid_arg "Bad asset asks";
    let l_owner = order_owner l in
    let r_owner = order_owner r in
    let r_filled = min r_avail r_desired_amt in
    let l_unfulfilled = max 0 (r_desired_amt - l_avail) in
    let r_unfulfilled = max 0 (l_desired_amt - r_avail) in
    (* We create a bucket of the unfulfilled amount for both sides. *)
    Bucket.
      {
        colour = `Order;
        from =
          Some
            {
              colour = `Order;
              from =
                Some
                  {
                    colour = `Order;
                    from = Some (chain_buckets r_buck l_buck);
                    owner = l_owner;
                    spent = l_unfulfilled;
                    returned = 0;
                    asset = r_desired_asset;
                    ts;
                  };
              owner = r_owner;
              spent = r_unfulfilled;
              returned = 0;
              asset = l_desired_asset;
              ts;
            };
        owner = l_owner;
        spent = r_filled;
        returned = 0;
        asset = l_desired_asset;
        ts;
      }

  and commit_right_filled_to_bucket (Applicative.Commit (ts, l, r)) =
    (* For both sides of this operation, we must greedily consume
     * everything so we can commit it to storage where appropriate. *)
    let r_buck = order_to_bucket r in
    let l_avail = order_amt l in
    let r_desired_amt = order_desired_amt r in
    let r_desired_asset = order_desired_asset r in
    if not (r_desired_asset = order_asset l) then invalid_arg "Bad asset asks";
    let filled = min l_avail r_desired_amt in
    let owner = order_owner l in
    Bucket.
      {
        colour = `Ephereal;
        from = Some r_buck;
        owner;
        spent = filled;
        returned = 0;
        asset = r_desired_asset;
        ts;
      }

  and withdraw_to_bucket Applicative.(Withdraw b) =
    match b with
    | Applicative.(Balance { bal_ms_ts; bal_owner; bal_asset; bal_amt }) as from
      ->
        Bucket.
          {
            colour = `Ephereal;
            from = Some (bal_to_bucket from);
            owner = bal_owner;
            spent = 0;
            returned = bal_amt;
            asset = bal_asset;
            ts = bal_ms_ts;
          }
    | Applicative.Commit_left_filled_to_balance c ->
        let b = commit_left_filled_to_bucket c in
        let Bucket.{ owner; spent; asset; ts; _ } = b in
        Bucket.
          {
            colour = `Ephereal;
            from = Some b;
            owner;
            spent = 0;
            returned = spent;
            asset;
            ts;
          }
end

module Apply = struct
  module Uncommitted_bals = Map.Make (struct
    type t = string * string
    (** t of type (address, asset) -> amount *)

    let compare (x, y) (x', y') =
      match compare x x' with 0 -> compare y y' | x -> x
  end)

  module Orders = Map.Make (struct
    type t = string * string * int
    (** of type (owner * asset * ms ts) -> amount *)

    let compare (owner, asset, ts) (owner', asset', ts') =
      match (compare owner owner', compare asset asset', compare ts ts') with
      | 0, 0, x | 0, x, 0 -> x
      | x, 0, 0 -> x
      | x, _, _ -> x
  end)

  type storage = { uncommitted : int Uncommitted_bals.t; orders : int Orders.t }

  let pp_uncommitted fmt =
    Uncommitted_bals.iter (fun (o, a) v ->
        Format.fprintf fmt "{ (%s, %s): %d }" o a v)

  let pp_orders fmt =
    Orders.iter (fun (owner, asset, ts) v ->
        Format.fprintf fmt " { (%s, %s, %d): %d }," owner asset ts v)

  let pp fmt { uncommitted; orders } =
    Format.fprintf fmt "Apply { uncommitted = [%a]; orders = [%a] }"
      pp_uncommitted uncommitted pp_orders orders

  let show = Format.asprintf "%a" pp
  let empty = { uncommitted = Uncommitted_bals.empty; orders = Orders.empty }

  let with_bals bals =
    {
      empty with
      uncommitted =
        List.fold_left
          (fun acc (a, v) -> Uncommitted_bals.add a v acc)
          empty.uncommitted bals;
    }

  let apply_ephereal ({ uncommitted = u; _ } as t)
      Bucket.{ colour; owner; spent; returned; asset; _ } =
    if not (colour = `Ephereal) then invalid_arg "Bucket not Ethereal";
    (* When the Ephereal type is used, we take the balance from the user's
     * unspent pool. *)
    (* If the user has enough balance, we subtract the amount that they've asked. *)
    {
      t with
      uncommitted =
        Uncommitted_bals.update (owner, asset)
          (function
            | None when spent > 0 -> invalid_arg "User has no uncommited bal"
            | None -> Some returned
            | Some uncommitted_amt when spent > uncommitted_amt ->
                invalid_arg "User does not have enough bal"
            | Some uncommitted_amt ->
                Printf.eprintf
                  "Uncommited amt change, owner %s, asset %s, new amount: %d\n"
                  owner asset
                  (uncommitted_amt - spent + returned);
                Some (uncommitted_amt - spent + returned))
          u;
    }

  let apply_order ({ orders = o; _ } as t)
      Bucket.{ colour; owner; spent; asset; ts; _ } =
    if not (colour = `Order) then invalid_arg "Bucket not Order";
    (* When someone applies their state to an order, we need to increase their balance in
     * the order that corresponds to the timestamp that was in this order. The reason being
     * that this is now a UTXO, spendable. *)
    { t with orders = Orders.update (owner, asset, ts) (fun _ -> Some spent) o }

  (** `apply t bucket` descends, using the stack, into the bucket list given.
      Bucket application only stores the spent amounts to the storage slots
      where appropriate. *)
  let apply ?(before = Fun.id) ?(after = Fun.id) =
    let rec loop t x =
      let inner t = function
        | Bucket.{ colour = `Ephereal; from = Some from; _ } as b ->
            apply_ephereal (loop t from) b
        | Bucket.{ colour = `Ephereal; _ } as b -> apply_ephereal t b
        | Bucket.{ colour = `Order; from = Some from; _ } as b ->
            apply_order (loop t from) b
        | Bucket.{ colour = `Order; _ } as b -> apply_order t b
      in
      after (inner (before t) x)
    in
    loop
end

let () =
  let test_order_example =
    OUnit2.( >:: ) "Test entire pipeline" @@ fun ctx ->
    (* Erik is looking to trade 1 ETH for 2 ARB... *)
    let storage =
      Apply.with_bals [ (("Erik", "ERIK"), 2); (("Alex", "ALEX"), 2) ]
    in
    let erik =
      Applicative.(
        Order
          {
            ord_desired_asset = "ALEX";
            ord_desired_amt = 2;
            ord_from =
              Balance
                {
                  bal_ms_ts = 1;
                  bal_owner = "Erik";
                  bal_asset = "ERIK";
                  bal_amt = 2;
                };
          })
    in
    (* Alex is looking to trade 3 ARB for 2 ETH. A partial fill will happen. *)
    let alex =
      Applicative.(
        Order
          {
            ord_desired_asset = "ERIK";
            ord_desired_amt = 2;
            ord_from =
              Balance
                {
                  bal_ms_ts = 2;
                  bal_owner = "Alex";
                  bal_asset = "ALEX";
                  bal_amt = 2;
                };
          })
    in
    Format.eprintf "Bucket: %a@." Bucket.pp (Convert.order_to_bucket alex);
    Format.eprintf "Storage: %a@." Apply.pp
      (Apply.apply storage (Convert.order_to_bucket alex));
    print_newline ();
    let commit = Applicative.Commit (1, erik, alex) in
    let left_filled = Applicative.Commit_left_filled_to_balance commit in
    let withdraw = Applicative.Withdraw left_filled in
    let bucket = Convert.withdraw_to_bucket withdraw in
    Format.eprintf "Bucket: %a@." Bucket.pp bucket;
    let apply =
      Apply.apply
        ~before:(fun x ->
          OUnit2.logf ctx `Info "Before: %s\n" (Apply.show x);
          x)
        ~after:(fun x ->
          OUnit2.logf ctx `Info "After: %s\n" (Apply.show x);
          x)
    in
    Format.eprintf "%a@." Apply.pp (apply storage bucket)
  in
  let open OUnit2 in
  run_test_tt_main ("Test reference core algorithm" >::: [ test_order_example ])
